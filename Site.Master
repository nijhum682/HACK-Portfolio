<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="project1.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hardware Acceleration Club of KUET (HACK)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css?v=4">
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <canvas id="hardware-bg"></canvas>
    <form id="form1" runat="server">
        <!-- Header -->
        <header class="header">
            <nav class="navbar">
                <div class="nav-container">
                    <div class="logo">
                        <h1>HACK</h1>
                    </div>
                    <div class="hamburger" id="hamburger">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                    <ul class="nav-menu" id="navMenu">
                        <li><a href="index.aspx" class="nav-link">Home</a></li>
                        <li><a href="about.aspx" class="nav-link">About</a></li>
                        <li><a href="activities.aspx" class="nav-link">Activities</a></li>
                        <li><a href="achievements.aspx" class="nav-link">Achievements</a></li>
                        <li><a href="team.aspx" class="nav-link">Team</a></li>
                        <li><a href="resources.aspx" class="nav-link">Resources</a></li>
                        <li><a href="contact.aspx" class="nav-link">Contact</a></li>
                        <li><a href="signup.aspx" class="nav-link">Sign Up</a></li>
                        <li><a href="signin.aspx" class="nav-link">Sign In</a></li>
                        <li><a href="profile.aspx" class="nav-link">Profile</a></li>
                    </ul>
                </div>
            </nav>
        </header>

        <main>
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <footer>
            <p>&copy; 2026 Hardware Acceleration Club of KUET (HACK)</p>
        </footer>

        <script>
            // Mobile menu toggle
            const hamburger = document.getElementById('hamburger');
            const navMenu = document.getElementById('navMenu');
            const navLinks = navMenu.querySelectorAll('.nav-link');

            hamburger.addEventListener('click', () => {
                hamburger.classList.toggle('active');
                navMenu.classList.toggle('active');
            });

            // Close menu when a link is clicked
            navLinks.forEach(link => {
                link.addEventListener('click', () => {
                    hamburger.classList.remove('active');
                    navMenu.classList.remove('active');
                });
            });

            // Highlight current active page link
            const currentPath = window.location.pathname.split('/').pop().toLowerCase();
            let pageName = currentPath;
            if (pageName.includes('?')) {
                pageName = pageName.split('?')[0];
            }
            if (pageName === "" || pageName === "/") {
                pageName = "index.aspx";
            }

            navLinks.forEach(link => {
                let linkPath = link.getAttribute('href').toLowerCase();
                if (linkPath.includes('?')) {
                    linkPath = linkPath.split('?')[0];
                }
                // Match exact page name, or match variations of page names (e.g. team.aspx, team_new.aspx -> Team)
                if (linkPath === pageName || (pageName.startsWith('team') && linkPath === 'team.aspx')) {
                    link.classList.add('active');
                } else {
                    link.classList.remove('active');
                }
            });
        </script>

        <script>
            // Hardware-themed background animation (Digital Circuit Board Network)
            (function() {
                const canvas = document.getElementById('hardware-bg');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');
                if (!ctx) return;
                
                let width = canvas.width = window.innerWidth;
                let height = canvas.height = window.innerHeight;
                
                const particles = [];
                const maxParticles = 120;
                const connectionDist = 115;
                
                const style = getComputedStyle(document.documentElement);
                const primaryColor = style.getPropertyValue('--primary').trim() || '#00d4ff';
                const accentColor = style.getPropertyValue('--accent').trim() || '#ff006e';
                
                class Particle {
                    constructor() {
                        this.reset();
                    }
                    
                    reset() {
                        this.x = Math.random() * width;
                        this.y = Math.random() * height;
                        this.vx = (Math.random() - 0.5) * 0.35;
                        this.vy = (Math.random() - 0.5) * 0.35;
                        
                        const rand = Math.random();
                        if (rand > 0.60) {
                            this.type = 'node';
                            this.size = Math.random() * 2 + 1.5;
                        } else if (rand > 0.30) {
                            this.type = 'bit';
                            this.size = Math.random() * 2 + 1.5;
                            this.char = Math.random() > 0.5 ? '0' : '1';
                        } else {
                            const iconRand = Math.random();
                            this.type = iconRand > 0.75 ? 'cpu' : (iconRand > 0.5 ? 'gear' : (iconRand > 0.25 ? 'diode' : 'robot'));
                            this.size = Math.random() * 9 + 9;
                        }
                        
                        this.angle = Math.random() * Math.PI * 2;
                        this.angularVelocity = (Math.random() - 0.5) * 0.012;
                        this.pulse = Math.random() * Math.PI;
                        this.pulseSpeed = 0.008 + Math.random() * 0.015;
                        this.hoverActive = false;
                        this.hoverFactor = 0;
                    }
                    
                    update() {
                        this.x += this.vx;
                        this.y += this.vy;
                        
                        this.hoverActive = false;
                        this.hoverFactor = 0;
                        if (mouse.active) {
                            const dx = this.x - mouse.x;
                            const dy = this.y - mouse.y;
                            const dist = Math.sqrt(dx * dx + dy * dy);
                            if (dist < 160) {
                                this.hoverActive = true;
                                this.hoverFactor = 1 - (dist / 160);
                                
                                this.angle += this.angularVelocity * (1 + this.hoverFactor * 6);
                                
                                const pushStrength = this.hoverFactor * 0.15;
                                this.x += (dx / (dist || 1)) * pushStrength;
                                this.y += (dy / (dist || 1)) * pushStrength;
                            } else {
                                this.angle += this.angularVelocity;
                            }
                        } else {
                            this.angle += this.angularVelocity;
                        }
                        
                        this.pulse += this.pulseSpeed;
                        
                        const margin = this.size + 15;
                        if (this.x < -margin || this.x > width + margin || this.y < -margin || this.y > height + margin) {
                            this.reset();
                        }
                    }
                    
                    draw() {
                        let baseAlpha = 0.12 + 0.18 * (Math.sin(this.pulse) * 0.5 + 0.5);
                        if (this.hoverActive) {
                            baseAlpha += this.hoverFactor * 0.25;
                        }
                        const alpha = Math.min(0.55, baseAlpha);
                        
                        ctx.fillStyle = this.type === 'bit' ? accentColor : primaryColor;
                        ctx.strokeStyle = this.type === 'bit' ? accentColor : primaryColor;
                        ctx.globalAlpha = alpha;
                        
                        if (this.type === 'node') {
                            ctx.beginPath();
                            ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                            ctx.fill();
                        } else if (this.type === 'bit') {
                            ctx.font = `${Math.floor(this.size * 2 + 7)}px monospace`;
                            ctx.fillText(this.char, this.x, this.y);
                        } else {
                            ctx.save();
                            ctx.translate(this.x, this.y);
                            ctx.rotate(this.angle);
                            ctx.lineWidth = 1.2;
                            
                            if (this.type === 'cpu') {
                                ctx.beginPath();
                                ctx.rect(-this.size, -this.size, this.size * 2, this.size * 2);
                                ctx.rect(-this.size * 0.5, -this.size * 0.5, this.size, this.size);
                                
                                const pinLen = this.size * 0.25;
                                const pinSpacing = this.size * 0.5;
                                for (let offset = -this.size * 0.5; offset <= this.size * 0.5; offset += pinSpacing) {
                                    ctx.moveTo(offset, -this.size);
                                    ctx.lineTo(offset, -this.size - pinLen);
                                    ctx.moveTo(offset, this.size);
                                    ctx.lineTo(offset, this.size + pinLen);
                                    ctx.moveTo(-this.size, offset);
                                    ctx.lineTo(-this.size - pinLen, offset);
                                    ctx.moveTo(this.size, offset);
                                    ctx.lineTo(this.size + pinLen, offset);
                                }
                                ctx.stroke();
                            } else if (this.type === 'gear') {
                                ctx.beginPath();
                                ctx.arc(0, 0, this.size * 0.35, 0, Math.PI * 2);
                                ctx.stroke();
                                
                                ctx.beginPath();
                                ctx.arc(0, 0, this.size * 0.7, 0, Math.PI * 2);
                                ctx.stroke();
                                
                                const teeth = 8;
                                const innerR = this.size * 0.7;
                                const outerR = this.size * 0.9;
                                for (let i = 0; i < teeth; i++) {
                                    const a1 = (i * Math.PI * 2) / teeth - 0.15;
                                    const a2 = (i * Math.PI * 2) / teeth + 0.15;
                                    
                                    ctx.beginPath();
                                    ctx.moveTo(Math.cos(a1) * innerR, Math.sin(a1) * innerR);
                                    ctx.lineTo(Math.cos(a1) * outerR, Math.sin(a1) * outerR);
                                    ctx.lineTo(Math.cos(a2) * outerR, Math.sin(a2) * outerR);
                                    ctx.lineTo(Math.cos(a2) * innerR, Math.sin(a2) * innerR);
                                    ctx.stroke();
                                }
                            } else if (this.type === 'diode') {
                                ctx.beginPath();
                                ctx.moveTo(-this.size, 0);
                                ctx.lineTo(-this.size * 0.4, 0);
                                ctx.moveTo(this.size * 0.4, 0);
                                ctx.lineTo(this.size, 0);
                                
                                ctx.moveTo(-this.size * 0.4, -this.size * 0.4);
                                ctx.lineTo(this.size * 0.4, 0);
                                ctx.lineTo(-this.size * 0.4, this.size * 0.4);
                                ctx.closePath();
                                
                                ctx.moveTo(this.size * 0.4, -this.size * 0.4);
                                ctx.lineTo(this.size * 0.4, this.size * 0.4);
                                ctx.stroke();
                            } else if (this.type === 'robot') {
                                ctx.beginPath();
                                ctx.rect(-this.size, -this.size * 0.7, this.size * 2, this.size * 1.3);
                                
                                ctx.moveTo(-this.size * 0.45 + this.size * 0.12, -this.size * 0.1);
                                ctx.arc(-this.size * 0.45, -this.size * 0.1, this.size * 0.12, 0, Math.PI * 2);
                                ctx.moveTo(this.size * 0.45 + this.size * 0.12, -this.size * 0.1);
                                ctx.arc(this.size * 0.45, -this.size * 0.1, this.size * 0.12, 0, Math.PI * 2);
                                
                                ctx.rect(-this.size * 0.35, this.size * 0.25, this.size * 0.7, this.size * 0.12);
                                
                                ctx.rect(-this.size - this.size * 0.15, -this.size * 0.2, this.size * 0.15, this.size * 0.35);
                                ctx.rect(this.size, -this.size * 0.2, this.size * 0.15, this.size * 0.35);
                                
                                ctx.moveTo(0, -this.size * 0.7);
                                ctx.lineTo(0, -this.size * 1.1);
                                ctx.stroke();
                                
                                ctx.beginPath();
                                ctx.arc(0, -this.size * 1.1, this.size * 0.12, 0, Math.PI * 2);
                                ctx.stroke();
                            }
                            ctx.restore();
                        }
                    }
                }
                
                for (let i = 0; i < maxParticles; i++) {
                    particles.push(new Particle());
                }
                
                let mouse = { x: null, y: null, active: false };
                window.addEventListener('mousemove', (e) => {
                    mouse.x = e.clientX;
                    mouse.y = e.clientY;
                    mouse.active = true;
                });
                window.addEventListener('mouseleave', () => {
                    mouse.active = false;
                });
                
                function drawCircuitTraces() {
                    for (let i = 0; i < particles.length; i++) {
                        const p1 = particles[i];
                        
                        if (p1.type === 'node') {
                            for (let j = i + 1; j < particles.length; j++) {
                                const p2 = particles[j];
                                if (p2.type !== 'node') continue;
                                
                                const dx = p1.x - p2.x;
                                const dy = p1.y - p2.y;
                                const dist = Math.sqrt(dx * dx + dy * dy);
                                
                                if (dist < connectionDist) {
                                    let alpha = (1 - dist / connectionDist) * 0.12;
                                    if (p1.hoverActive || p2.hoverActive) {
                                        alpha *= 1.5;
                                    }
                                    ctx.strokeStyle = primaryColor;
                                    ctx.lineWidth = 0.7;
                                    ctx.globalAlpha = Math.min(0.4, alpha);
                                    
                                    ctx.beginPath();
                                    ctx.moveTo(p1.x, p1.y);
                                    
                                    if ((i + j) % 4 === 0 && dist > 50) {
                                        ctx.lineTo(p2.x, p1.y);
                                    }
                                    
                                    ctx.lineTo(p2.x, p2.y);
                                    ctx.stroke();
                                    
                                    if ((i + j) % 7 === 0 && Math.sin(p1.pulse) > 0.85) {
                                        const progress = (Math.sin(p1.pulse * 2) + 1) / 2;
                                        const pulseX = p1.x + (p2.x - p1.x) * progress;
                                        const pulseY = p1.y + (p2.y - p1.y) * progress;
                                        ctx.fillStyle = accentColor;
                                        ctx.globalAlpha = Math.min(0.9, alpha * 3.5);
                                        ctx.beginPath();
                                        ctx.arc(pulseX, pulseY, 2.5, 0, Math.PI * 2);
                                        ctx.fill();
                                    }
                                }
                            }
                        }
                        
                        if (mouse.active) {
                            const dx = p1.x - mouse.x;
                            const dy = p1.y - mouse.y;
                            const dist = Math.sqrt(dx * dx + dy * dy);
                            if (dist < 160) {
                                const alpha = (1 - dist / 160) * 0.20;
                                ctx.strokeStyle = accentColor;
                                ctx.lineWidth = 0.8;
                                ctx.globalAlpha = alpha;
                                ctx.beginPath();
                                ctx.moveTo(p1.x, p1.y);
                                ctx.lineTo(mouse.x, mouse.y);
                                ctx.stroke();
                            }
                        }
                    }
                }
                
                function animate() {
                    ctx.clearRect(0, 0, width, height);
                    
                    particles.forEach(p => {
                        p.update();
                        p.draw();
                    });
                    
                    drawCircuitTraces();
                    
                    requestAnimationFrame(animate);
                }
                
                window.addEventListener('resize', () => {
                    width = canvas.width = window.innerWidth;
                    height = canvas.height = window.innerHeight;
                });
                
                animate();
            })();
        </script>
    </form>
</body>
</html>
