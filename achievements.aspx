<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="achievements.aspx.cs" Inherits="project1.achievements" MasterPageFile="~/Site.Master" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">

        <section id="achievements" class="hero">
            <div class="hero-content">
                                <h1 class="hero-title">
                    <div class="word">
                        <span style="animation-delay: 0.05s;">O</span><span style="animation-delay: 0.1s;">u</span><span style="animation-delay: 0.15s;">r</span>
                    </div>
                    <div class="word">
                        <span style="animation-delay: 0.25s;">A</span><span style="animation-delay: 0.3s;">c</span><span style="animation-delay: 0.35s;">h</span><span style="animation-delay: 0.4s;">i</span><span style="animation-delay: 0.45s;">e</span><span style="animation-delay: 0.5s;">v</span><span style="animation-delay: 0.55s;">e</span><span style="animation-delay: 0.6s;">m</span><span style="animation-delay: 0.65s;">e</span><span style="animation-delay: 0.7s;">n</span><span style="animation-delay: 0.75s;">t</span><span style="animation-delay: 0.8s;">s</span>
                    </div>
                </h1>
                <p class="hero-tagline">Celebrating Our Successes and Milestones</p>
            </div>
            <div class="hero-background">
                <div class="circle circle-1"></div>
                <div class="circle circle-2"></div>
                <div class="circle circle-3"></div>
            </div>
        </section>

        <section class="content-section" style="padding-bottom: 0;">
            <h2>Club Achievements</h2>
            <p style="margin-bottom: 0;">This section will highlight the notable achievements of the Hardware Acceleration Club of KUET (HACK). Details about awards, successful projects and other milestones will be added here soon.</p>
        </section>
        
        <section class="content-section activities-gallery" style="padding-top: 1rem;">
            <h2>Innovation Gallery</h2>
            <div class="activity-item">
                <img src="img/bitfest2025.jpeg" alt="Arranging BitFest-2025" class="activity-image">
                <h3>Arranging BitFest-2025</h3>
            </div>
            <div class="activity-item">
                <img src="img/3dprinter.jpeg" alt="3D Printer" class="activity-image">
                <h3>3D Printer</h3>
            </div>
            <div class="activity-item">
                <img src="img/automatedhand.jpeg" alt="Automated Hand" class="activity-image">
                <h3>Automated Hand</h3>
            </div>
            <div class="activity-item">
                <img src="img/digitalattendencesystem.jpeg" alt="Digital Attendence System" class="activity-image">
                <h3>Digital Attendence System</h3>
            </div>
            <div class="activity-item">
                <img src="img/drone.jpeg" alt="Drone" class="activity-image">
                <h3>Drone</h3>
            </div>
            <div class="activity-item">
                <img src="img/gashumiditydetector.jpeg" alt="Gas & Humidity Detector" class="activity-image">
                <h3>Gas & Humidity Detector</h3>
            </div>
            <div class="activity-item">
                <img src="img/LFR.jpeg" alt="Line Follower Robot (LFR)" class="activity-image">
                <h3>Line Follower Robot (LFR)</h3>
            </div>
            <div class="activity-item">
                <img src="img/LFRchampionsbitfest.jpeg" alt="LFR at Bitfest-2025 LFR Champion" class="activity-image">
                <h3>LFR at Bitfest-2025 LFR Champion</h3>
            </div>
        </section>
    
</asp:Content>
